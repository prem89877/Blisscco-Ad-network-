{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "plugins": [],
    "types": [
      "node"
    ],
    "noUncheckedSideEffectImports": false
  },
  "include": [
    "lib/ads/**/*.ts",
    "lib/campaigns/constants.ts",
    "lib/campaigns/validation.ts",
    "lib/campaigns/filters.ts",
    "lib/campaigns/run-state.ts",
    "lib/campaigns/review.ts",
    "lib/campaigns/creative-validation.ts",
    "lib/campaigns/types.ts",
    "lib/campaigns/budget.ts",
    "lib/campaigns/budget-rules.ts",
    "lib/campaigns/money.ts",
    "lib/campaigns/errors.ts",
    "lib/campaigns/advertiser.ts",
    "lib/accounts/validation.ts",
    "lib/admin/decisions.ts",
    "lib/auth/redirect.ts",
    "lib/auth/site-url-parse.ts",
    "lib/auth/validation.ts",
    "lib/dashboard-nav.ts",
    "lib/site.ts",
    "lib/publisher/keys.ts",
    "lib/publisher/keys-db.ts",
    "lib/publisher/publisher.ts",
    "app/dashboard/advertiser/campaigns/actions.ts",
    "app/dashboard/account/actions.ts",
    "app/dashboard/publisher/actions.ts",
    "app/api/ads/match/route.ts",
    "app/api/v1/ads/match/route.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".test-build"
  ]
}
