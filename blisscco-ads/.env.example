# Blisscco - Supabase (sirf placeholder, asli values yahan KABHI mat likhna)
# Asli values sirf Vercel > Settings > Environment Variables me daalo.

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase PUBLISHABLE key (sb_publishable_...). Browser me jaa sakti hai.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# OPTIONAL: tumhari site ka asli URL (verification email ka link isi par jayega).
# Khali chhodo toh request ke host se apne aap nikalta hai.
NEXT_PUBLIC_SITE_URL=https://YOUR-SITE.vercel.app

# OPTIONAL: public contact email, /privacy page par dikhta hai (apna email yahan daalo).
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Secret key (sb_secret_...). Ad-matching API (app/api/v1/ads/match aur purana app/api/ads/match) ko chahiye.
# SIRF server par: Vercel > Settings > Environment Variables me BINA NEXT_PUBLIC_ ke daalo.
# Is key se RLS bypass hota hai. Kabhi GitHub me commit mat karna, browser code me mat lana.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# NOTE (publisher API keys): publisher ki API key (blc_live_...) is project ke env me KABHI nahi jaati.
# Wo database me sirf hash ho kar rehti hai. Publisher apni key apne SERVER ke env me rakhta hai
# (jaise BLISSCCO_PUBLISHER_API_KEY, bina kisi public prefix ke). Is file me koi asli key mat likhna.
# Publisher guide: app/dashboard/publisher/guide/page.tsx. Contract: DAY6-ADS-MATCH-CONTRACT.md.
