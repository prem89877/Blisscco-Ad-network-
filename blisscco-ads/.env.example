# Blisscco - Supabase (sirf placeholder, asli values yahan KABHI mat likhna)
# Asli values sirf Vercel > Settings > Environment Variables me daalo.

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase PUBLISHABLE key (sb_publishable_...). Browser me jaa sakti hai.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Secret key (sb_secret_...) / service_role key is stage me use NAHI hoti.
# Use Vercel me mat daalo. Aage zarurat padi toh bina NEXT_PUBLIC_ ke, sirf server par.
