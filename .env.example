# Blisscco - environment variables (sirf placeholder, asli values yahan KABHI mat likhna)
# Asli values sirf Vercel > Settings > Environment Variables me daalo. Poori list + kaun sa kahan: DAY14-PART3-PRODUCTION-ENV.md
# Public (browser me jaane wale) variables ke liye sirf NEXT_PUBLIC_ wale 4 naam allowed hain. Secret ko kabhi NEXT_PUBLIC_ mat lagao
# (build us par ruk jata hai: config/public-env-guard.mjs).

# =====================================================================
# REQUIRED (production): teeno na ho toh login / dashboard / ad API kaam nahi karte (server logs me variable ka NAAM aata hai)
# =====================================================================

# Supabase Project URL (public, browser me jaana theek hai)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase PUBLISHABLE key (sb_publishable_...). Public hai, browser me jaa sakti hai.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Secret key (sb_secret_...). Ad API (app/api/v1/ads/*, purana app/api/ads/match), publisher key manager aur ledger ko chahiye.
# SIRF server par: Vercel > Settings > Environment Variables me BINA NEXT_PUBLIC_ ke daalo, "Sensitive" ON.
# Is key se RLS bypass hota hai. Kabhi GitHub me commit mat karna, browser code me mat lana.
# Isme publishable/anon key ya placeholder lagi ho toh server saaf error deta hai (value log nahi hoti).
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# =====================================================================
# OPTIONAL
# =====================================================================

# Tumhari site ka asli URL (verification email ka link isi par jayega).
# Khali chhodo toh request ke host se apne aap nikalta hai. (Vercel khud VERCEL_PROJECT_PRODUCTION_URL deta hai: wo haath se set nahi karna.)
NEXT_PUBLIC_SITE_URL=https://YOUR-SITE.vercel.app

# Public contact email, /privacy aur /terms page par dikhta hai (apna email yahan daalo).
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Tracking token ka signing secret (impression / click). OPTIONAL: set na ho (ya 32 se kam characters / kamzor / placeholder ho)
# toh tracking SAFELY band rehti hai: ad matching bilkul pehle jaisa chalti hai, bas jawab me `tracking` nahi aata,
# aur impression/click endpoints "unavailable" dete hain. SIRF server par, BINA NEXT_PUBLIC_ ke, "Sensitive" ON.
# Kam se kam 32 characters; 64 random hex behtar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Placeholder (YOUR-...) ko code secret maanta hi nahi: jab tak tum apna random secret na daalo, tracking band rehti hai (safe default).
# Supabase secret key, publisher key (blc_live_...) ya koi aur credential yahan KABHI mat daalo (code unhe reject karta hai).
AD_TRACKING_SECRET=YOUR-RANDOM-SECRET-AT-LEAST-32-CHARS-LONG
# Secret rotate karte waqt purana secret yahan rakho (purane tokens tab tak verify hote hain); naye token hamesha AD_TRACKING_SECRET se bante hain.
# AD_TRACKING_SECRET_PREVIOUS=
# Token ki umr seconds me (60 se 86400; default 3600). Serve ke samay se gini jaati hai.
# AD_TRACKING_TTL_SECONDS=3600

# Phase 4 Step 3B: Rich Ad Delivery (brand_name / logo_url / image_url in the match response + GET /api/v1/ads/asset/[id] image proxy).
# OPTIONAL, default BAND: exact value 1 chahiye. Band ho toh match jawab purane 5 fields jaisa rehta hai aur asset route sab par 404 deta hai.
# Pehle sirf TEST / Preview environment me 1 karo. Production me tab tak mat chhedo jab tak owner likhit faisla na de.
# RICH_AD_DELIVERY_ENABLED=1

# Phase 5 Step 4/6: Emergency stop (admin "Stop all ad serving" button). OPTIONAL, default BAND: exact value 1 chahiye.
# Band ho toh button sirf database flag badalta hai aur ad endpoint use padhta hi nahi (ads chalte rehte hain).
# 1 hone par ad endpoint har request par flag padhta hai; flag padhna fail ho toh 503 (fail closed).
# Pehle sirf TEST / Preview me 1 karo. Production me tab tak mat chhedo jab tak phase5-step4-1 SQL Production par apply na ho
# aur owner likhit faisla na de. Server-only, bina NEXT_PUBLIC_ ke. Isme koi secret nahi hota (sirf 0/1 jaisa switch).
# EMERGENCY_STOP_ENFORCED=1

# Phase 6 Step 2 Part 1: regional eligibility gate (sirf VERIFIED publisher country ko regional ads). OPTIONAL, default BAND: exact value 1 chahiye.
# Band ho toh ad endpoint publisher ki country padhta hi nahi (purana behaviour same). 1 hone par har request par country state padhi jaati hai:
# pending / rejected / missing / invalid country => no-fill; padhna fail ho toh 503 (fail closed). Part 2: ON hone par campaign targeting bhi lagti hai (campaigns.target_regions,
# phase6-step2-2 SQL; null / khali = sirf Rest of World). Isliye phase6-step2-2 SQL apply kiye bina ON mat karo (warna 503). Pehle sirf TEST / Preview me, phase6-step2-1 SQL apply hone ke baad.
# Production me tab tak mat chhedo jab tak owner likhit faisla na de. Server-only, bina NEXT_PUBLIC_ ke. Koi secret nahi.
# REGIONAL_ELIGIBILITY_ENFORCED=1

# NOTE (publisher API keys): publisher ki API key (blc_live_...) is project ke env me KABHI nahi jaati.
# Wo database me sirf hash ho kar rehti hai. Publisher apni key apne SERVER ke env me rakhta hai
# (jaise BLISSCCO_PUBLISHER_API_KEY, bina kisi public prefix ke). Is file me koi asli key mat likhna.
# Publisher guide: app/dashboard/publisher/guide/page.tsx. Contract: DAY6-ADS-MATCH-CONTRACT.md.

# Phase 5 Step 5: advertiser payments ke liye Cashfree (owner ka faisla). SIRF SANDBOX. Ye sab KHALI / COMMENTED rehta hai jab tak sandbox keys na ho.
# Khali ya set na hone par /api/payments/webhook hamesha 503 deta hai aur kuch nahi likhta (safe default). CASHFREE_ENV "sandbox" ke alawa kuch bhi => adapter band.
# SIRF Vercel Preview + Cashfree TEST/SANDBOX keys, "Sensitive" ON, kabhi NEXT_PUBLIC_ ke saath nahi, kabhi git me nahi. Production par aur live keys kabhi nahi (owner ke likhit faisle tak).
# PAYMENT_PROVIDER=cashfree
# CASHFREE_ENV=sandbox
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=

# Phase 5 Step 6: Cashfree ne account activate nahi kiya (2026-11-09). Owner ka naya faisla: advertiser payments ke liye Razorpay, SIRF TEST MODE.
# Ye sab KHALI / COMMENTED rehta hai jab tak Razorpay ka likhit approval (ad network / prepaid ad credits category) aur test keys na hon.
# Code live keys (rzp_live...) ko reject karta hai. Sirf Vercel Preview, "Sensitive" ON, kabhi NEXT_PUBLIC_ ke saath nahi, kabhi git me nahi.
# RAZORPAY_WEBHOOK_SECRET API key secret se alag hota hai (Razorpay dashboard > Webhooks me khud chuna jata hai).
# Publisher payouts Payoneer se MANUAL rehte hain (koi Payoneer API / key yahan nahi).
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_MODE=test
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Diagnostics (OPTIONAL, koi secret nahi, bina NEXT_PUBLIC_ ke). Vercel > Logs me "[diag]" search karo.
# DIAG_SLOW_MS: itne milliseconds se zyada lage toh "request_slow" line (default 3000).
# DIAG_VERBOSE=1: har /dashboard, /login, /signup request ki ek "request_trace" line (rsc / prefetch / conditional = 304 ka sambhaw). Default band, kaam khatam hone par hata do.
# DIAG_SLOW_MS=3000
# DIAG_VERBOSE=1
